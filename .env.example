# Database Configuration
DB_TYPE=sqlite
DB_PATH=screener.db

# For PostgreSQL
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stock_screener
# DB_USER=postgres
# DB_PASSWORD=your_password

# For MongoDB
# DB_TYPE=mongodb
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=stock_screener

# RSI Parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Timeframe (in minutes)
TIMEFRAME=60

# Scan Interval (in minutes)
SCAN_INTERVAL=60

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# Logging
LOG_LEVEL=INFO
LOG_FILE=screener.log

# GEM Logic Platform
WATCHLIST_PATH=config/watchlist.json
GEM_RSI_OVERSOLD=28
GEM_RSI_OVERBOUGHT=72
GEM_LOOKBACK_BARS=84
GEM_DIV_COUNT=3
GEM_CONFIRM_WINDOW=8
